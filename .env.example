# URL del backend (Adonis) y la clave compartida (debe igualar BOT_API_KEY del backend)
API_URL=http://localhost:4444
BOT_API_KEY=cambia-esta-clave
# Cada cuántos ms se consultan sesiones y cola
SESSIONS_POLL_MS=2000
OUTBOX_POLL_MS=2000
# Pausa aleatoria entre mensajes (anti-spam), en ms
SEND_DELAY_MIN_MS=1500
SEND_DELAY_MAX_MS=4000
# Carpeta donde se guardan las sesiones de WhatsApp
SESSIONS_DIR=./.sessions

# Cada cuántos ms se consultan sesiones cuando NO hay nada cambiando
SESSIONS_IDLE_MS=6000
# En producción (Railway) deja 0: cada navegador en espera cuesta ~200 MB de RAM.
# Navegadores precargados en espera para que el QR salga al instante (0 = desactivado)
PRELOAD_MAX=2
