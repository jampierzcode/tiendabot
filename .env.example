# URL del backend (Adonis) y la clave compartida (debe igualar BOT_API_KEY del backend)
API_URL=http://localhost:4444
BOT_API_KEY=cambia-esta-clave
# Cada cuántos ms se consultan sesiones y cola
SESSIONS_POLL_MS=2000
OUTBOX_POLL_MS=2000
# Pausa aleatoria entre mensajes (anti-spam), en ms
SEND_DELAY_MIN_MS=1500
SEND_DELAY_MAX_MS=4000
# Carpeta donde se guardan las sesiones de WhatsApp. En Railway: un volumen en /data y SESSIONS_DIR=/data/sessions,
# si no, cada despliegue borra las sesiones y todos los negocios tienen que volver a escanear el QR.
SESSIONS_DIR=./.sessions

# Cada cuántos ms se consultan sesiones cuando NO hay nada cambiando
SESSIONS_IDLE_MS=6000

# Mensajes seguidos del cliente que llegan dentro de esta ventana se responden juntos (ms)
INBOUND_DEBOUNCE_MS=2500
# Un QR que nadie escanea se cierra pasado este tiempo (ms) para no gastar memoria
QR_TIMEOUT_MS=180000
# Registro interno de Baileys (silent, error, info, debug) para depurar conexiones
BAILEYS_LOG=silent
